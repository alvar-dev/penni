{
  "expo": {
    "name": "Junction S-Pankki",
    "slug": "junction-spankki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fi.junction.rahavalmentaja"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Mikrofonia käytetään, jotta voit kysyä puhumalla."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mikrofonia käytetään, jotta voit kysyä puhumalla.",
          "speechRecognitionPermission": "Puheentunnistus muuttaa kysymyksesi tekstiksi.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "backgroundColor": "#FFFFFF"
  }
}
